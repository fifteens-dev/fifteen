# Spotify API credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=your_redirect_uri_here

# Apple Music API credentials
# Generate a Developer Token from https://developer.apple.com/account
# 1. Create a MusicKit Identifier in your Apple Developer account
# 2. Create a private key (.p8 file) associated with MusicKit
# 3. Generate a JWT token using your Team ID, Key ID, and private key
# 4. The token is valid for up to 6 months
APPLE_MUSIC_DEVELOPER_TOKEN=your_developer_token_here

# Firebase configuration (optional - using google-services.json instead)
# Firebase config is loaded from google-services.json (Android) and GoogleService-Info.plist (iOS)
