# Spotify API credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=your_redirect_uri_here

# Firebase configuration (optional - using google-services.json instead)
# Firebase config is loaded from google-services.json (Android) and GoogleService-Info.plist (iOS)
